# Copy this file to .env and fill in the values before running `make up`.

# Required: JWT signing secret, minimum 32 characters.
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more

# Optional: Mistral API key to enable AI question generation.
# MISTRAL_API_KEY=

# Optional: override the PostgreSQL password (default: quizz)
# POSTGRES_PASSWORD=quizz
